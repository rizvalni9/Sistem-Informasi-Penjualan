	<queryString>
		<![CDATA[SELECT nt.idtrs, nt.nmptrs, nt.tbyr_trs, nt.tgltrs, tr.nmbrg, tr.hrgbrg, tr.jpbrg, tr.tphbrg FROM nota AS nt INNER JOIN transaction AS tr ON tr.idtrs = nt.idtrs WHERE substring(nt.tgltrs,7,10) = $P{tgl}]]>
	</queryString>
