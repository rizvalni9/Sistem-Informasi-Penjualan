	<parameter name="id_trs" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT nt.idtrs,
nt.nmutrs,
nt.tgltrs,
nt.nmptrs,
nt.tbyr_trs,
nt.pbyr_trs,
nt.kbyr_trs,
tr.idtrs,
tr.nmbrg,
tr.hrgbrg,
tr.jpbrg,
tr.tphbrg,
com.company,
com.address,
com.phone,
com.image
FROM nota AS nt 
INNER JOIN transaction AS tr ON tr.idtrs = nt.idtrs
INNER JOIN comiden AS com ON 1=1
WHERE nt.idtrs = $P{id_trs}]]>
	</queryString>
